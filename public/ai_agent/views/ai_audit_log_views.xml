<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_audit_log_list_view_agent" model="ir.ui.view">
        <field name="name">ai.audit.log.list.agent</field>
        <field name="model">ai.audit.log</field>
        <field name="inherit_id" ref="ai_base.ai_audit_log_list_view"/>
        <field name="arch" type="xml">
            <field name="session_id" position="after">
                <field name="agent_id" optional="show"/>
                <field name="run_id" optional="hide"/>
            </field>
        </field>
    </record>
    <record id="ai_audit_log_form_view_agent" model="ir.ui.view">
        <field name="name">ai.audit.log.form.agent</field>
        <field name="model">ai.audit.log</field>
        <field name="inherit_id" ref="ai_base.ai_audit_log_form_view"/>
        <field name="arch" type="xml">
            <field name="session_id" position="after">
                <field name="agent_id"/>
                <field name="run_id"/>
            </field>
        </field>
    </record>
</odoo>
