<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="agent_default_assistant" model="ai.agent">
            <field name="name">Assistant</field>
            <field name="description">Fallback agent for dedicated menus that do not pass an agent. Systray chat does not bind this record.</field>
            <field name="system_prompt">You are an Odoo assistant. Use registered tools when they help answer the user. Do not invent records that are not in the database.</field>
            <field name="run_mode">chat</field>
            <field name="is_default" eval="True"/>
            <field name="memory_enabled" eval="True"/>
            <field name="max_rounds">8</field>
            <field name="max_tool_calls_per_round">10</field>
        </record>
    </data>
    <data noupdate="1">
        <record id="ir_cron_agent_runs" model="ir.cron">
            <field name="name">AI Agent: Continue goal runs</field>
            <field name="model_id" ref="model_ai_agent_run"/>
            <field name="state">code</field>
            <field name="code">model._cron_step_runs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
