<templates id="template" xml:space="preserve">
	<!-- A Menu search result -->
	<t t-name="spiffy_theme_backend.MenuSearchResults">
		<t t-foreach="results" t-as="result" t-key="result.id">
			<t t-set="menu" t-value="widget._menuInfo(result)" />
			<li class="search_list_content list-unstyled">
				<t t-if="menu.actionPath" t-set="url" t-value="'/odoo/' + menu.actionPath"/>
				<t t-else=" " t-set="url" t-value="'/odoo/action-' + menu.actionID"/>
		
				<a
					t-attf-class="autoComplete_highlighted text-small text-muted mb-0"
					t-att-href="url"
					t-att-data-menu-id="menu.id"
					t-att-data-action-id="menu.actionID"
					t-esc="result"
					role="menuitem"
				/>
			</li>
		</t>
	</t>

	<t t-name="spiffy_theme_backend.AppIcon">
		<img t-if="icon.iconType == 'img'" t-attf-class="img img-fluid {{iconExtraClass or ''}}" t-att-src="icon.iconSrc"/>
		<span t-else="" t-attf-class="{{icon.iconClass}} {{iconExtraClass or ''}}"/>
	</t>

	<t t-name="spiffy_theme_backend.AppDrawerQuery">
		<div t-att-class="{ 'd-none': !drawer.query, 'd-flex': drawer.query }" class="flex-wrap searched_main_apps">
			<t t-foreach="drawer.searchedApps" t-as="app" t-key="app.id">
				<div class="app-box mb16">
					<a role="menuitem" t-attf-href="#menu_id={{app.id}}" class="d-block o_app text-center" t-att-data-menu-id="app.id" t-att-data-menu-xmlid="app.xmlid" t-att-data-action-id="app.actionID">
						<div class="app-image mb8">
							<t t-set="icon" t-value="appIcon(app)"/>
							<t t-set="iconExtraClass" t-value="''"/>
							<t t-call="spiffy_theme_backend.AppIcon"/>
						</div>
						<div class="app-name">
							<t t-esc="app.name"/>
						</div>
					</a>
					<div class="fav_app_select d-none" t-on-click.stop="() => this.onToggleFavorite(app)">
						<span class="ri ri-check-line" t-att-class="{ active: drawer.favoriteIds[app.id] }"/>
					</div>
				</div>
			</t>
		</div>
		<div class="search_result">
			<t t-foreach="drawer.menuResults" t-as="result" t-key="result.name">
				<li t-att-class="{ navigate_active: result_index === drawer.activeResult }" class="search_list_content list-unstyled">
					<a t-att-href="result.href" class="autoComplete_highlighted text-small text-muted mb-0" t-att-data-menu-id="result.id" t-att-data-action-id="result.actionID" t-esc="result.name" role="menuitem"/>
				</li>
			</t>
		</div>
	</t>
	
	<t t-inherit="web.NavBar" t-inherit-mode="extension" >
		<xpath expr="//header[hasclass('o_navbar')]" position="attributes">
			<attribute name="t-on-click">onSpiffyMenuClick</attribute>
		</xpath>
		<xpath expr="//nav[hasclass('o_main_navbar')]" position="before">
			<div class="fav_app_island" t-att-class="{ 'd-none': !drawer.showIsland }">
				<span class="ri ri-apps-2-line fav_app_island_btn"/>
				<div class="fav_apps d-flex alige-items-center justify-content-center">
					<t t-foreach="drawer.favoriteApps" t-as="fav" t-key="fav.id">
						<div class="app-box">
							<a role="menuitem" t-att-href="fav.href" class="d-block o_app text-center" t-att-data-menu-id="fav.id" t-att-data-menu-xmlid="fav.xmlid" t-att-data-action-id="fav.actionID" t-att-title="fav.name">
								<div class="app-image">
									<t t-set="icon" t-value="fav"/>
									<t t-set="iconExtraClass" t-value="'o_image_64_max'"/>
									<t t-call="spiffy_theme_backend.AppIcon"/>
								</div>
							</a>
						</div>
					</t>
				</div>
			</div>
			<div class="float-end d-flex align-items-center header_menu_right_content flex-wrap">
				<li class="bookmark_list list-unstyled">
					<div t-foreach="bookmarks.list" t-as="bookmark" t-key="bookmark.id" class="d-inline-block bookmark_div">
						<a role="menuitem"
							t-att-href="bookmark.url"
							class="bookmark_tag btn-light btn demo_btn d-block o_app text-center"
							t-att-class="{ active: bookmark.active }"
							t-att-bookmark-id="bookmark.id"
							t-att-bookmark-name="bookmark.name"
							t-att-title="bookmark.name"
							t-on-contextmenu.prevent="(ev) => this._showbookmarkoptions(bookmark, ev)"
							t-esc="bookmark.title"/>
						<div t-if="bookmarks.optionsFor === bookmark.id" class="bookmark_options py-2 px-3 d-flex flex-column shadow" t-att-bookmark_id="bookmark.id">
							<a class="rename_bookmark d-block me-0 px-0 py-1" t-on-click.prevent.stop="() => this._startRenameBookmark(bookmark)">Rename</a>
							<a class="remove_bookmark d-block me-0 px-0 py-1" t-on-click.prevent.stop="() => this._RemoveBookmark(bookmark.id)">Remove</a>
						</div>
						<div t-if="bookmarks.renamingFor === bookmark.id" class="bookmark_rename_section" t-att-bookmark_id="bookmark.id">
							<p class="">Rename</p>
							<div class="form-group">
								<input type="text" class="form-control" name="bookmark_rename" id="bookmark_rename"
									t-att-value="bookmarks.renameValue"
									t-on-input="(ev) => this.bookmarks.renameValue = ev.target.value"
									t-on-click.stop=""/>
							</div>
							<div class="dropdown-divider"></div>
							<div class="d-flex">
								<a class="btn btn-primary bookmark_rename" t-on-click.prevent.stop="() => this._UpdateBookmark(bookmark.id, this.bookmarks.renameValue)">Rename</a>
								<a class="btn btn-secondary me-0 bookmark_rename_cancel" t-on-click.prevent.stop="() => this._cancelRenameBookmark()">Cancel</a>
							</div>
						</div>
					</div>
				</li>

				<li class="bookmark_section list-unstyled">
					<div class="dropdown">
						<button type="button" class="btn btn-light dropdown-toggle demo_btn" data-bs-toggle="dropdown" title="Add Bookmark" t-on-click="_getCurrentPageName">
							<span class="fa fa-bookmark-o" />
						</button>
						<div class="dropdown-menu bookmark_page_add">
							<p class="">Add Bookmark</p>
							<div class="form-group">
								<input type="text" class="form-control" name="bookmark_page_name" id="bookmark_page_name"
									t-att-value="bookmarks.newName"
									t-on-input="(ev) => this.bookmarks.newName = ev.target.value" />
							</div>
							<div class="dropdown-divider"></div>
							<div class="d-flex">
								<a class="btn btn-primary add_bookmark" t-on-click="_saveBookmarkPage">Add</a>
								<a class="btn btn-secondary me-0 cancel_bookmark">Cancel</a>
							</div>
						</div>
					</div>
				</li>
				<li class="fav_app_drawer list-unstyled">
					<button type="button" class="btn btn-light fav_app_drawer_btn" title="Favourite Apps" t-on-click="_OpenFavAppdrawer">
						<span class="ri ri-star-line"/>
					</button>
				</li>

				<li class="magnifier_section list-unstyled">
					<div class="">
						<button type="button" class="btn btn-light magnifier_btn demo_btn" title="Magnifier" t-on-click="_toggleMagnifier">
							<span class="fa fa-search-plus" />
						</button>
						<div id="magnifier" class="collapse position-absolute bg-white zoom-style-box" t-att-class="{ show: magnifier.open }">
							<div class="d-flex align-items-center">
								<span class="zoom_value ps-2" t-esc="zoom.value"/>
								<span>%</span>
								<div class="zoom-style d-flex align-items-center mx-2">
									<a class="btn btn-small minus" t-on-click="_magnifierZoomOut">-</a>
									<a class="btn btn-small plus" t-on-click="_magnifierZoomIn">+</a>
								</div>
								<a class="fa fa-repeat zoom-reset btn btn-secondary reset" t-on-click="_magnifierZoomReset"></a>
							</div>
						</div>
					</div>
				</li>
				<li class="search_view list-unstyled">
					<button type="button" class="btn btn-light search_bar demo_btn" accesskey="H" title="Search" t-on-click="_showSearchbarModal">
						<span class="fa fa-search" />
					</button>
				</li>
				<li class="fullscreen_section list-unstyled">
					<a class="btn btn-light full_screen demo_btn" accesskey="F" title="FullScreen" t-att-class="{ 'fullscreen-exit': fullscreen.active }" t-on-click="_FullScreenMode">
						<span class="fa fa-expand" />
					</a>
				</li>
			</div>
			<div class="header_menu_right_content_toggler">
				<button type="button" class="btn btn-primary bookmark_panel_toggle" title="Bookmark Panel" t-on-click="_ToggleBookmarkPanel">
					<span class="ri ri-arrow-left-s-line"/>
				</button>
			</div>
			<!-- SEARCH MODAL -->
			<ThemeConfigurator state="configuratorState"/>
			<div class="new_systray d-none">
				<div class="o_app_drawer d-block d-lg-none">
					<li class="list-unstyled">
						<a class="appDrawerToggle me-3" t-att-class="{ toggle: drawer.open }" accesskey="A" t-on-click="_OpenAppdrawer">
							<span class="ri ri-apps-2-line"/>
						</a>
					</li>
				</div>
				<div class="company_logo_brand d-none d-md-flex align-items-center">
					<div class="o_company_logo d-none d-md-block">
						<t t-if="currentCompany">
							<img class="img img-fluid company_logo" t-attf-src="/web/image?model=res.company&amp;field=backend_menubar_logo&amp;id={{currentCompany.id}}"/>
							<img class="img img-fluid company_logo_icon d-none" t-attf-src="/web/image?model=res.company&amp;field=backend_menubar_logo_icon&amp;id={{currentCompany.id}}"/>
						</t>
					</div>
					<div class="o_brand_name">
						<DropdownItem
							t-if="!this.ui.isSmall and currentApp"
							t-esc="currentApp.name"
							class="'o_menu_brand d-flex'"
							onSelected="() => this.onNavBarDropdownItemSelection(currentApp)"
							attrs="{ href: getMenuItemHref(currentApp), 'data-menu-xmlid': currentApp.xmlid, 'data-section': currentApp.id }"
						/>
					</div>
					<t t-if="currentAppSections.length and !this.ui.isSmall and !isIpad" t-call="web.NavBar.SectionsMenu">
						<t t-set="sections" t-value="currentAppSections" />
					</t>
				</div>
				<!-- Systray -->
				<div class="o_menu_systray" role="menu">
					<t t-foreach="systrayItems" t-as="item" t-key="item.key">
						<!-- This ensures the correct order of the systray items -->
						<div t-att-data-index="item.index"/>
						<ErrorHandler onError="error => this.handleItemError(error, item)">
							<t t-component="item.Component" t-props="item.props"/>
						</ErrorHandler>
					</t>
				</div>
			</div>
			<TodoSidebar state="todoSidebarState"/>
		</xpath>
		<xpath expr="//nav[hasclass('o_main_navbar')]" position="replace">
			<nav class="o_main_navbar" t-att-class="{ 'appdrawer-toggle': drawer.open }" t-on-dropdown-item-selected="onNavBarDropdownItemSelection" data-command-category="navbar">
				<div class="o_app_drawer">
					<li class="list-unstyled">
						<a class="appDrawerToggle me-3" t-att-class="{ toggle: drawer.open }" accesskey="A" t-on-click="_OpenAppdrawer">
							<span class="ri ri-apps-2-line"/>
						</a>
					</li>
				</div>
				<div class="o_company_logo">
					<t t-if="currentCompany">
						<img class="img img-fluid company_logo" t-attf-src="/web/image?model=res.company&amp;field=backend_menubar_logo&amp;id={{currentCompany.id}}"/>
						<img class="img img-fluid company_logo_icon d-none" t-attf-src="/web/image?model=res.company&amp;field=backend_menubar_logo_icon&amp;id={{currentCompany.id}}"/>
					</t>
				</div>

				<!-- Systray -->
				<div class="o_menu_systray" role="menu">

					<t t-foreach="systrayItems" t-as="item" t-key="item.key">
						<!-- This ensures the correct order of the systray items -->
						<div t-att-data-index="item.index"/>
						<ErrorHandler onError="error => this.handleItemError(error, item)">
							<t t-component="item.Component" t-props="item.props"/>
						</ErrorHandler>
					</t>
				</div>

				<!-- Apps Menu -->
				<t t-call="web.NavBar.AppsMenu">
					<t t-set="apps" t-value="menuService.getApps()" />
				</t>

				<div class="favorite_apps_section d-none"></div>

				

				<!-- App Brand -->
				<DropdownItem
					t-if="!this.ui.isSmall and currentApp"
					t-esc="currentApp.name"
					class="'o_menu_brand d-flex'"
					onSelected="() => this.onNavBarDropdownItemSelection(currentApp)"
					attrs="{ href: getMenuItemHref(currentApp), 'data-menu-xmlid': currentApp.xmlid, 'data-section': currentApp.id }"
				/>

				<!-- Current App Sections -->
				<t t-if="currentAppSections.length and !this.ui.isSmall and !isIpad" t-call="web.NavBar.SectionsMenu">
					<t t-set="sections" t-value="currentAppSections" />
				</t>
				<!-- Mobile App sections -->
				<t t-call="spiffy.Mobile.SectionsMenu">
					<t t-set="sections" t-value="currentAppSections" />
				</t>
			</nav>
		</xpath>
	</t>

	<t t-name="spiffy.Mobile.SectionsMenu" >
		<div class="o_menu_sections d-none" t-att-class="{ toggle: mobileMenu.open }">
			<a id="mobileMenuclose" class="menu-button" style="display: none;" t-on-click="_mobileHeaderClose">
				<span class="ri ri-close-line align-middle"></span>
			</a>
			<a t-if="currentApp" class="o_menu_brand" t-att-href="getMenuItemHref(currentApp)" t-on-click.prevent="() => this.onNavBarDropdownItemSelection(currentApp)">
				<t t-esc="currentApp.name"/>
			</a>
			<t t-foreach="sections" t-as="first_level_menu" t-key="first_level_menu.id">
				<t t-if="!first_level_menu.childrenTree.length">
					<t t-call="spiffy.Menu.link">
						<t t-set="inNavbar" t-value="true"/>
						<t t-set="menu" t-value="first_level_menu"/>
					</t>
				</t>
				<t t-else="">
					<li class="list-unstyled">
						<a href="#" class="dropdown-toggle o-no-caret o_menu_header_lvl_1" t-att-data-menu-xmlid="first_level_menu.xmlid" data-bs-toggle="dropdown" data-display="static" role="button" aria-expanded="false">
							<t t-esc="first_level_menu.name"/>
						</a>
						<div class="dropdown-menu" role="menu">
							<t t-foreach="first_level_menu.childrenTree" t-as="second_level_menu" t-key="second_level_menu.id">
								<t t-call="spiffy.Menu.link">
									<t t-set="depth" t-value="1"/>
									<t t-set="menu" t-value="second_level_menu"/>
								</t>
							</t>
						</div>
					</li>
				</t>
			</t>
		</div>
	</t>

	<t t-name="spiffy.Menu.link" >
		<t t-set="depth" t-value="(depth || 0) + 1"/>
	
		<t t-if="!menu.childrenTree.length">
			<a role="menuitem" t-attf-href="#menu_id={{menu.id}}&amp;action={{menu.actionID ? menu.actionID : ''}}"
					t-att-data-menu="menu.id"
					t-att-data-action-model="menu.actionModel"
					t-att-data-action-id="menu.actionID"
					t-att-data-menu-xmlid="menu.xmlid"
					t-attf-class="{{inNavbar ? '' : 'dropdown-item '}}o_menu_entry_lvl_{{depth}}"
					>
					<span><t t-esc="menu.name"/></span>
			</a>
		</t>
		<t t-else="">
			<div t-attf-class="dropdown-header o_menu_header_lvl_{{depth}}">
				<span><t t-esc="menu.name"/></span>
			</div>
			<t t-foreach="menu.childrenTree" t-as="menu" t-key="menu.id">
				<t t-call="spiffy.Menu.link"/>
			</t>
		</t>
	</t>


	<t t-inherit="web.NavBar.AppsMenu.Sidebar" t-inherit-mode="extension" >
		<xpath expr="//div[hasclass('o_sidebar_topbar')]" position="replace">
			<div class="o_sidebar_topbar d-flex align-items-center justify-content-between flex-shrink-0 py-0 fs-4">
				<span class="d-flex align-items-center justify-content-between ms-2">
				</span>
				<button class="o_sidebar_close oi oi-close btn d-flex align-items-center h-100 bg-transparent border-0 fs-2 text-reset" aria-label="Close menu" title="Close menu" t-on-click.stop="_closeAppMenuSidebar"/>
          </div>
		</xpath>
		
	</t>

	<t t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension" >
		<xpath expr="//Dropdown" position="replace">
			<div class="o_navbar_apps_menu all-apps-menus">
				<SpiffyMenuGroup placement="'sidebar'"/>
			</div>
			<div class="o_navbar_apps_menu">
				<div class="appdrawer_section" t-att-class="{ toggle: drawer.open, show_favourite_apps: drawer.showFavorites }">
					<div class="top_navbar_section mb-3 mb-md-5">
						<a class="close_fav_app_btn d-none" t-on-click="_CloseAppdrawer">
							<span class="ri ri-arrow-left-s-line"/>
						</a>
					</div>
					<div class="container">
						<div class="input-group">
							<div class="input-group-prepend d-flex">
								<span class="input-group-text">
									<i class="ri ri-search-line"></i>
								</span>
							</div>
							<input type="text" class="form-control app_menu_search" placeholder="Search" t-ref="drawerSearchDesktop" t-att-value="drawer.query" t-on-input="onAppDrawerSearchInput" t-on-keydown="onAppDrawerSearchKeydown"/>
						</div>
						<div class="apps-list mt-3 mt-md-5" t-att-class="{ 'd-none': drawer.showFavorites }">
							<div class="spiffy-app-group" t-att-class="{ 'd-none': drawer.query }">
								<SpiffyMenuGroup placement="'drawer'"/>
							</div>
							<t t-call="spiffy_theme_backend.AppDrawerQuery"/>
						</div>
						<div class="apps-list favourite_apps mt-3 mt-md-5" t-att-class="{ 'd-none': !drawer.showFavorites }">
							<div class="row m-0" t-att-class="{ 'd-none': drawer.query }">
								<t t-foreach="menuService.getApps()" t-as="app" t-key="app.id">
									<div class="app-box mb16">
										<a role="menuitem" t-attf-href="#menu_id={{app.id}}&amp;action={{app.actionID ? app.actionID : ''}}" class="d-block o_app text-center" t-att-data-menu-id="app.id" t-att-data-menu-xmlid="app.xmlID" t-att-data-action-id="app.actionID">
											<div class="app-image mb8">
												<t t-set="icon" t-value="appIcon(app)"/>
												<t t-set="iconExtraClass" t-value="''"/>
												<t t-call="spiffy_theme_backend.AppIcon"/>
											</div>
											<div class="app-name">
												<t t-esc="app.name" />
											</div>
										</a>
										<div class="fav_app_select d-none" t-on-click.stop="() => this.onToggleFavorite(app)">
											<span class="ri ri-check-line" t-att-class="{ active: drawer.favoriteIds[app.id] }"/>
										</div>
									</div>
								</t>
							</div>
							<t t-call="spiffy_theme_backend.AppDrawerQuery"/>
						</div>
					</div>
				</div>
			</div>
		</xpath>
		<!--Mobile view-->
		<xpath expr="//a" position="replace">
			<a href="/odoo" class="o_menu_toggle border-0" t-att-class="{'hasImage': currentApp?.webIconData}" accesskey="h" t-ref="menuApps" t-on-click.prevent="_openAppMenuSidebar">
				<t t-call="web.NavBar.AppsMenu.Sidebar"/>
			</a>
			<div class="o_navbar_apps_menu">
				<!-- The dynamic menu app is loaded in this div -->
				<div class="all-apps-menus"></div>
				<div class="appdrawer_section" t-att-class="{ toggle: drawer.open, show_favourite_apps: drawer.showFavorites }">
					<div class="top_navbar_section mb-3 mb-md-5">
						<a class="close_fav_app_btn d-none" t-on-click="_CloseAppdrawer">
							<span class="ri ri-arrow-left-s-line"/>
						</a>
					</div>
					<div class="container">
						<div class="input-group">
							<div class="input-group-prepend d-flex">
								<span class="input-group-text">
									<i class="ri ri-search-line"></i>
								</span>
							</div>
							<input type="text" class="form-control app_menu_search" placeholder="Search" t-ref="drawerSearchMobile" t-att-value="drawer.query" t-on-input="onAppDrawerSearchInput" t-on-keydown="onAppDrawerSearchKeydown"/>
						</div>
						<div class="apps-list mt-3 mt-md-5" t-att-class="{ 'd-none': drawer.showFavorites }">
							<!-- The dynamic menu app is loaded in this div -->
							<div class="spiffy-app-group" t-att-class="{ 'd-none': drawer.query }"/>
							<t t-call="spiffy_theme_backend.AppDrawerQuery"/>
						</div>
					</div>
				</div>
			</div>
		</xpath>
	</t>

	<!-- Rendered inside the SpiffyMenuGroup component: store, hasActiveDescendant,
	     getMenuItemHref and menuService come from that component's context. -->
	<t t-name="AllmenuRecursive" >
		<div class="nav-item">
			<t t-if="menu.childrenTree.length">
				<p class="bg-muted">
					<a class="d-flex align-items-center w-100" t-att-class="{ active: hasActiveDescendant(menu) }" data-bs-toggle="collapse" t-attf-data-bs-target="#child_menu_{{menu.id}}" t-att-data-menu-xmlid="menu.xmlid">
						<span><t t-esc="menu.name"/></span>
						<span class="ri ri-arrow-right-s-line ms-auto"/>
					</a>
				</p>
			</t>
			<t t-else="">
				<a t-att-data-menu="menu.id" t-attf-class="child_menus" t-att-class="{ active: store.activeChildId === menu.id }" t-att-href="getMenuItemHref(menu)" t-att-data-menu-xmlid="menu.xmlid" t-attf-data-action-id="{{menu.actionID ? menu.actionID : ''}}">
					<span class="app_name">
						<t t-esc="menu.name" />
					</span>
				</a>
			</t>
			<div t-attf-id="child_menu_{{menu.id}}" class="collapse" t-att-class="{ show: hasActiveDescendant(menu) }">
				<div t-if="menu.childrenTree.length" class="show">
					<t t-foreach="menu.children" t-as="menuid" t-key="menuid">
						<t t-set="menu" t-value="menuService.getMenuAsTree(menuid)"/>
						<t t-call="AllmenuRecursive" />
					</t>
				</div>
			</div>
		</div>
	</t>
	
