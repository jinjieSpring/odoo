<templates id="template" xml:space="preserve">
    <t t-inherit="web.ListRenderer.RecordRow" t-inherit-mode="extension">
        <xpath expr="//tr[hasclass('o_data_row')]" position="attributes">
            <attribute name="t-att-resId">record.resId</attribute>
            <attribute name="t-on-contextmenu">onRowContextMenu</attribute>
        </xpath>
        <xpath expr="//tr[hasclass('o_data_row')]" position="after">
            <t t-set="attachments" t-value="rowAttachments(record)"/>
            <tr t-if="attachments.length" class="o_spiffy_attachment_row">
                <td t-att-colspan="nbCols" class="o_spiffy_attachment_cell border-0 p-0">
                    <div class="attachment_div new">
                        <section class="biz_attachment_section d-flex align-items-center position-absolute flex-nowrap overflow-auto" t-att-id="record.id">
                            <t t-foreach="attachments" t-as="attachment" t-key="attachment.key">
                                <div t-if="!attachment.counter" class="attachment_box border d-flex align-items-center mx-2" t-on-click.stop="() => this.onAttachmentBoxClick(attachment, record.resId)">
                                    <span class="o_image me-2" t-att-data-mimetype="attachment.attachment_mimetype"/>
                                    <div class="attachment-name text-nowrap">
                                        <span t-esc="attachment.attachment_name"/>
                                    </div>
                                </div>
                                <div t-else="" class="attachment_box border attachment_box_counter d-flex align-items-center px-2" t-on-click.stop="() => this.onAttachmentBoxClick(attachment, record.resId)">
                                    <div class="attachment-name text-nowrap">
                                        <span t-esc="attachment.label"/>
                                    </div>
                                </div>
                            </t>
                        </section>
                    </div>
                </td>
            </tr>
        </xpath>
    </t>

    <t t-inherit="web.ListRenderer" t-name="spiffy_split_view.ListRenderer" t-inherit-mode="extension">
        <xpath expr="//table[contains(@t-attf-class, 'o_list_table')]" position="before">
            <t t-if="!this.isX2Many">
                <div t-att-data-js="filterRow" t-attf-class="filter_row p-3 pb-0 column-gap-1 row-gap-2 align-items-center">
                    <td t-if="hasSelectors"></td>
                    <t t-foreach="columns" t-as="column" t-key="column.id">
                        <td t-if="column.type === 'field'">

                            <t
                                t-if="column.fieldType !== 'binary' and column.widget !== 'image'  and column.fieldType != 'boolean'">
                            <div>
                                <div>
                                    <div class="input-group">
                                        <div class="form-control d-flex align-items-center py-0 px-0 me-1 focus">
                                            <input type="text"
                                                class="form-control form-control-md column-filter border-0"
                                                t-att-data-column="column.name"
                                                t-att-data-field-type="column.fieldType"
                                                t-att-data-fieldname="column.string"
                                                t-att-placeholder="column.string"
                                                t-on-click="onColumnFilter"
                                                t-on-keydown="onColumnFilter"
                                                t-att-name="column.string"/>
                                        
                                            <span>
                                                <button type="button"
                                                    class="btn btn-md btn-primary-link domain-filter-btn"
                                                    t-att-data-column="column.name"
                                                    t-att-data-field-type="column.fieldType"
                                                    t-on-click="onDomainFilterClick"
                                                    title="Advanced Filter">
                                                    <i class="fa fa-filter text-info"></i>
                                                </button>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            </t>
                        </td>
                        <td t-else=""></td>
                    </t>
                    <td t-if="hasOpenFormViewColumn"></td>
                    <td t-if="hasActionsColumn"></td>
                </div>
            </t>
        </xpath>
    </t>      
</templates>