<templates xml:space="preserve">

    <t t-inherit="web.ActionMenus" t-inherit-mode="extension">
        <xpath expr="//t[@t-foreach='state.printItems']" position="replace">
            <t t-foreach="state.printItems" t-as="item" t-key="item.key">
                <div class="d-flex align-items-stretch spiffy-report-item-row">
                    <DropdownItem
                        class="(item.class || '') + ' spiffy-report-item-name flex-grow-1'"
                        onSelected="() => this.onItemSelected(item)"
                    >
                        <t t-out="item.description"/>
                    </DropdownItem>

                    <DropdownItem
                        t-if="item.action and item.action.report_name and item.action.report_type == 'qweb-pdf'"
                        class="'spiffy-report-preview-btn o_menu_item'"
                        onSelected="() => this.onPreviewReport(item)"
                    >
                        <i class="fa fa-external-link" title="Preview PDF" aria-label="Preview PDF"/>
                    </DropdownItem>
                </div>
            </t>
        </xpath>
    </t>

    <t t-inherit="web.CogMenu" t-inherit-mode="extension">
        <xpath expr="//DropdownItem[@t-foreach='state.printItems']" position="replace">
            <t t-foreach="state.printItems" t-as="item" t-key="item.key">
                <div class="d-flex align-items-stretch spiffy-report-item-row">
                    <DropdownItem
                        class="'o_menu_item spiffy-report-item-name flex-grow-1'"
                        attrs="{ 'aria-label': this.getPrintItemAriaLabel(item) }"
