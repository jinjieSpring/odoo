<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ai_base.AiEnhanceField">
        <div class="o_ai_enhance_field d-flex align-items-start gap-1 w-100">
            <div class="flex-grow-1">
                <t t-call="web.CharField"/>
            </div>
            <div class="btn-group">
                <button class="btn btn-secondary btn-sm" t-att-title="_t('AI generate')"
                        t-on-click="() => this.enhance('generate')">AI</button>
                <button class="btn btn-outline-secondary btn-sm" t-att-title="_t('Rewrite')"
                        t-on-click="() => this.enhance('rewrite')">R</button>
                <button class="btn btn-outline-secondary btn-sm" t-att-title="_t('Translate')"
                        t-on-click="() => this.enhance('translate')">T</button>
                <button class="btn btn-outline-secondary btn-sm" t-att-title="_t('Summarize')"
                        t-on-click="() => this.enhance('summarize')">S</button>
            </div>
        </div>
    </t>
</templates>
