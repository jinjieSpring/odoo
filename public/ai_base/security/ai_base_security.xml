<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ai_privilege" model="res.groups.privilege">
            <field name="name">AI</field>
            <field name="sequence">91</field>
            <field name="description">Generic AI capability groups.</field>
        </record>

        <record id="group_user" model="res.groups">
            <field name="name">AI User</field>
            <field name="privilege_id" ref="ai_privilege"/>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
            <field name="comment">Can use AI chat and call registered read-only tools.</field>
        </record>

        <record id="group_log" model="res.groups">
            <field name="name">AI Log Viewer</field>
            <field name="privilege_id" ref="ai_privilege"/>
            <field name="implied_ids" eval="[Command.link(ref('group_user'))]"/>
            <field name="comment">Can inspect AI request logs without changing configuration.</field>
        </record>

        <record id="group_manager" model="res.groups">
            <field name="name">AI Manager</field>
            <field name="privilege_id" ref="ai_privilege"/>
            <field name="implied_ids" eval="[Command.link(ref('group_log'))]"/>
            <field name="comment">Can configure providers, models, prompts, knowledge and tools.</field>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[Command.link(ref('group_manager'))]"/>
        </record>

        <record id="rule_provider_company" model="ir.rule">
            <field name="name">ai.provider: multi-company</field>
            <field name="model_id" ref="model_ai_provider"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        </record>

        <record id="rule_model_company" model="ir.rule">
            <field name="name">ai.model: multi-company</field>
            <field name="model_id" ref="model_ai_model"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        </record>

        <record id="rule_prompt_company" model="ir.rule">
            <field name="name">ai.prompt.template: multi-company</field>
            <field name="model_id" ref="model_ai_prompt_template"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        </record>

        <record id="rule_knowledge_company" model="ir.rule">
            <field name="name">ai.knowledge.base: multi-company</field>
            <field name="model_id" ref="model_ai_knowledge_base"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        </record>

        <record id="rule_document_company" model="ir.rule">
            <field name="name">ai.knowledge.document: multi-company</field>
            <field name="model_id" ref="model_ai_knowledge_document"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        </record>

        <record id="rule_chunk_company" model="ir.rule">
            <field name="name">ai.knowledge.chunk: multi-company</field>
            <field name="model_id" ref="model_ai_knowledge_chunk"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        </record>

        <record id="rule_session_own" model="ir.rule">
            <field name="name">ai.chat.session: own sessions, current companies</field>
            <field name="model_id" ref="model_ai_chat_session"/>
            <field name="domain_force">[('user_id', '=', user.id), '|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        </record>

        <record id="rule_session_log_viewer" model="ir.rule">
            <field name="name">ai.chat.session: company sessions readable by log viewers</field>
            <field name="model_id" ref="model_ai_chat_session"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('group_log'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_user_settings_own" model="ir.rule">
            <field name="name">ai.user.settings: own settings</field>
            <field name="model_id" ref="model_ai_user_settings"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        </record>

        <record id="rule_message_own" model="ir.rule">
            <field name="name">ai.chat.message: own session messages</field>
            <field name="model_id" ref="model_ai_chat_message"/>
            <field name="domain_force">[('session_id.user_id', '=', user.id), '|', ('session_id.company_id', '=', False), ('session_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        </record>

        <record id="rule_request_log_user" model="ir.rule">
            <field name="name">ai.request.log: own logs</field>
            <field name="model_id" ref="model_ai_request_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_user'))]"/>
        </record>

        <record id="rule_request_log_viewer" model="ir.rule">
            <field name="name">ai.request.log: company logs for viewers</field>
            <field name="model_id" ref="model_ai_request_log"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('group_log'))]"/>
        </record>

        <record id="rule_async_job_user" model="ir.rule">
            <field name="name">ai.async.job: own jobs</field>
            <field name="model_id" ref="model_ai_async_job"/>
            <field name="domain_force">[('user_id', '=', user.id), '|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
