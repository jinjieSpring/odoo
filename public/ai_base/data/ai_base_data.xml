<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="prompt_system_default" model="ai.prompt.template">
            <field name="name">Default System Prompt</field>
            <field name="code">system.default</field>
            <field name="category">system</field>
            <field name="system_prompt">You are an AI assistant embedded in Odoo. Answer questions about the database. You never modify records directly unless a registered tool is used.</field>
            <field name="content">You are an AI assistant embedded in Odoo. Answer questions about the database. You never modify records directly unless a registered tool is used.</field>
        </record>
        <record id="prompt_rag_context" model="ai.prompt.template">
            <field name="name">RAG Context</field>
            <field name="code">rag.context</field>
            <field name="category">rag</field>
            <field name="content">Relevant knowledge:
{% for item in items %}- {{ item.citation }} p.{{ item.page or '-' }} [{{ item.source_document }}] {{ item.content }}
{% endfor %}
Use it to answer "{{ query }}" when applicable; otherwise say you do not know.
When you use a source, cite it inline with its [SOURCE:...] marker.</field>
        </record>
        <record id="prompt_summary_default" model="ai.prompt.template">
            <field name="name">Default Summary</field>
            <field name="code">summary.default</field>
            <field name="category">summary</field>
            <field name="user_template">Summarize the following text concisely:\n{{ text }}</field>
            <field name="content">Summarize the following text concisely:
{{ text }}</field>
        </record>
        <record id="prompt_field_generate" model="ai.prompt.template">
            <field name="name">Field Generate</field>
            <field name="code">field.generate</field>
            <field name="category">field</field>
            <field name="user_template">Write a professional value for this field. Context: {{ text }}</field>
            <field name="content">Write a professional value for this field. Context: {{ text }}</field>
        </record>
        <record id="prompt_field_rewrite" model="ai.prompt.template">
            <field name="name">Field Rewrite</field>
            <field name="code">field.rewrite</field>
            <field name="category">field</field>
            <field name="user_template">Rewrite the following text, keep the meaning, improve clarity:\n{{ text }}</field>
            <field name="content">Rewrite the following text, keep the meaning, improve clarity:
{{ text }}</field>
        </record>
        <record id="prompt_field_translate" model="ai.prompt.template">
            <field name="name">Field Translate</field>
            <field name="code">field.translate</field>
            <field name="category">field</field>
            <field name="user_template">Translate the following text into {{ lang }}:\n{{ text }}</field>
            <field name="content">Translate the following text into {{ lang }}:
{{ text }}</field>
        </record>
        <record id="prompt_field_summarize" model="ai.prompt.template">
            <field name="name">Field Summarize</field>
            <field name="code">field.summarize</field>
            <field name="category">field</field>
            <field name="user_template">Summarize the following text in one or two sentences:\n{{ text }}</field>
            <field name="content">Summarize the following text in one or two sentences:
{{ text }}</field>
        </record>

        <record id="ir_cron_index_documents" model="ir.cron">
            <field name="name">AI Base: Index pending documents</field>
            <field name="model_id" ref="model_ai_knowledge_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_index_pending()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_gc_logs" model="ir.cron">
            <field name="name">AI Base: Purge old request logs</field>
            <field name="model_id" ref="model_ai_request_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_gc_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_error_alert" model="ir.cron">
            <field name="name">AI Base: Error rate alert</field>
            <field name="model_id" ref="model_ai_request_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_error_alert()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_async_jobs" model="ir.cron">
            <field name="name">AI Base: Run async jobs</field>
            <field name="model_id" ref="model_ai_async_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_jobs()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
