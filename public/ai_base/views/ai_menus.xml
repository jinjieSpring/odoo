<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="ai_menu_root" name="AI"
              sequence="91" web_icon="ai_base,static/description/icon.png"
              groups="ai_base.group_user"/>
    <record id="ai_menu_root" model="ir.ui.menu">
        <field name="action" eval="False"/>
    </record>

    <menuitem id="ai_menu_foundation" name="Foundation"
              parent="ai_menu_root"
              groups="ai_base.group_log" sequence="10"/>
    <menuitem id="ai_menu_providers" name="Providers"
              parent="ai_menu_foundation" action="ai_provider_action"
              groups="ai_base.group_manager" sequence="10"/>
    <menuitem id="ai_menu_models" name="Models"
              parent="ai_menu_foundation" action="ai_model_action"
              groups="ai_base.group_manager" sequence="20"/>
    <menuitem id="ai_menu_prompts" name="Prompt Templates"
              parent="ai_menu_foundation" action="ai_prompt_action"
              groups="ai_base.group_manager" sequence="30"/>
    <menuitem id="ai_menu_tools" name="AI Tools"
              parent="ai_menu_foundation" action="ai_tool_action"
              groups="ai_base.group_manager" sequence="50"/>
    <menuitem id="ai_menu_logs" name="Usage"
              parent="ai_menu_foundation" action="ai_request_log_action"
              groups="ai_base.group_log" sequence="70"/>
    <menuitem id="ai_menu_audit" name="Audit"
              parent="ai_menu_foundation" action="ai_audit_log_action"
              groups="ai_base.group_log" sequence="75"/>
    <menuitem id="ai_menu_settings" name="Configuration"
              parent="ai_menu_foundation" action="ai_config_action"
              groups="ai_base.group_manager" sequence="80"/>
</odoo>
