<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_provider_form_view" model="ir.ui.view">
        <field name="name">ai.provider.form</field>
        <field name="model">ai.provider</field>
        <field name="arch" type="xml">
            <form string="AI Provider">
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Connection"
                            class="oe_highlight"
                            groups="ai_base.group_manager"/>
                </header>
                <sheet>
                    <group>
                        <group string="General">
                            <field name="name"/>
                            <field name="provider_type"/>
                            <field name="is_active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Connection">
                            <field name="endpoint"/>
                            <field name="api_key" password="True" groups="ai_base.group_manager"/>
                            <field name="api_secret" password="True" groups="ai_base.group_manager"
                                   invisible="provider_type != 'ernie'"/>
                            <field name="timeout"/>
                            <field name="proxy"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" nolabel="1" placeholder="Optional remarks..."/>
                    </group>
                    <notebook>
                        <page string="Models">
                            <field name="model_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="model_kind"/>
                                    <field name="model_name_remote"/>
                                    <field name="is_default"/>
                                    <field name="is_active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ai_provider_list_view" model="ir.ui.view">
        <field name="name">ai.provider.list</field>
        <field name="model">ai.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="provider_type"/>
                <field name="endpoint"/>
                <field name="model_count"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>
    <record id="ai_provider_action" model="ir.actions.act_window">
        <field name="name">Providers</field>
        <field name="res_model">ai.provider</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
