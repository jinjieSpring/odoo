<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_prompt_form_view" model="ir.ui.view">
        <field name="name">ai.prompt.template.form</field>
        <field name="model">ai.prompt.template</field>
        <field name="arch" type="xml">
            <form string="Prompt Template">
                <header>
                    <button name="action_preview" type="object" string="Preview Render"
                            class="oe_highlight" groups="ai_base.group_manager"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="is_active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Field Rewrite"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. field.rewrite"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="version"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" colspan="2"
                               placeholder="Optional notes about this prompt."/>
                        <field name="system_prompt" colspan="2"
                               placeholder="Instructions for the model (optional)."/>
                        <field name="user_template" colspan="2"
                               placeholder="User message, e.g. Rewrite: {{ text }}"/>
                        <field name="content" colspan="2"
                               placeholder="Used when system + user templates are empty."/>
                    </group>
                    <notebook>
                        <page string="Preview" name="preview">
                            <group>
                                <group string="Preview Context (JSON)">
                                    <field name="preview_context" nolabel="1" colspan="2"
                                           placeholder='{"query": "Sample question"}'/>
                                </group>
                                <group string="Preview Result">
                                    <field name="preview_result" nolabel="1" colspan="2"
                                           placeholder="Click Preview Render to see the output."/>
                                </group>
                            </group>
                        </page>
                        <page string="Version History" name="history">
                            <field name="history_ids" nolabel="1">
                                <list>
                                    <field name="version"/>
                                    <field name="create_date" string="Created On"/>
                                    <button name="action_restore" type="object" string="Restore"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ai_prompt_list_view" model="ir.ui.view">
        <field name="name">ai.prompt.template.list</field>
        <field name="model">ai.prompt.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="version"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>
    <record id="ai_prompt_action" model="ir.actions.act_window">
        <field name="name">Prompt Templates</field>
        <field name="res_model">ai.prompt.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
