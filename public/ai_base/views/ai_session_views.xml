<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_session_form_view" model="ir.ui.view">
        <field name="name">ai.chat.session.form</field>
        <field name="model">ai.chat.session</field>
        <field name="arch" type="xml">
            <form string="Session History" create="0" edit="0" delete="0" duplicate="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="res_id" invisible="1"/>
                        <button name="action_open_related_record" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not res_id">
                            <field name="res_name" widget="statinfo" string="Related Record"/>
                        </button>
                        <button name="action_open_audit_logs" type="object"
                                class="oe_stat_button" icon="fa-shield">
                            <field name="audit_count" widget="statinfo" string="Audit"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="model_id"/>
                            <field name="prompt_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="attach_context"/>
                            <field name="thinking_enabled"/>
                            <field name="compress_strategy"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Messages">
                            <field name="message_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="create_date"/>
                                    <field name="role"/>
                                    <field name="content_preview"/>
                                    <field name="reasoning_preview" optional="hide"/>
                                    <field name="prompt_tokens" optional="hide" sum="Input Tokens"/>
                                    <field name="completion_tokens" optional="hide" sum="Output Tokens"/>
                                    <field name="total_tokens" optional="show" sum="Total Tokens"/>
                                    <field name="latency_ms" optional="hide" sum="Latency (ms)"/>
                                    <field name="model_code" optional="hide"/>
                                    <field name="status" optional="hide"/>
                                </list>
                                <form class="o_ai_message_form" create="0" edit="0" delete="0">
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="role"/>
                                                <field name="create_date"/>
                                                <field name="status"
                                                       invisible="role != 'assistant'"
                                                       widget="badge"
                                                       decoration-success="status == 'success'"
                                                       decoration-danger="status == 'error'"/>
                                            </group>
                                            <group invisible="role != 'assistant'">
                                                <field name="model_id"/>
                                                <field name="provider_id" invisible="not provider_id"/>
                                                <field name="latency_ms"/>
                                            </group>
                                        </group>
                                        <group string="Tokens" invisible="role != 'assistant'">
                                            <field name="prompt_tokens"/>
                                            <field name="completion_tokens"/>
                                            <field name="total_tokens"/>
                                        </group>
                                        <group invisible="not error_message">
                                            <field name="error_message" colspan="2"/>
                                        </group>
                                        <notebook>
                                            <page string="Content" name="content">
                                                <field name="content" nolabel="1"/>
                                            </page>
                                            <page string="Reasoning" name="reasoning"
                                                  invisible="not reasoning_content">
                                                <field name="reasoning_content" nolabel="1"/>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Record Context">
                            <field name="context_snapshot" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ai_session_list_view" model="ir.ui.view">
        <field name="name">ai.chat.session.list</field>
        <field name="model">ai.chat.session</field>
        <field name="arch" type="xml">
            <list string="Session History" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="user_id"/>
                <field name="model_id"/>
                <field name="res_name"/>
                <field name="message_count"/>
                <field name="input_tokens" optional="hide" sum="Input Tokens"/>
                <field name="output_tokens" optional="hide" sum="Output Tokens"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="ai_session_pivot_view" model="ir.ui.view">
        <field name="name">ai.chat.session.pivot</field>
        <field name="model">ai.chat.session</field>
        <field name="arch" type="xml">
            <pivot string="Session History">
                <field name="user_id" type="row"/>
                <field name="model_id" type="row"/>
                <field name="input_tokens" type="measure"/>
                <field name="output_tokens" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="ai_session_graph_view" model="ir.ui.view">
        <field name="name">ai.chat.session.graph</field>
        <field name="model">ai.chat.session</field>
        <field name="arch" type="xml">
            <graph string="Session History" type="bar">
                <field name="user_id"/>
                <field name="input_tokens" type="measure"/>
                <field name="output_tokens" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="ai_session_action" model="ir.actions.act_window">
        <field name="name">Session History</field>
        <field name="res_model">ai.chat.session</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>
</odoo>
