<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_adapter_form_view" model="ir.ui.view">
        <field name="name">ai.adapter.form</field>
        <field name="model">ai.adapter</field>
        <field name="arch" type="xml">
            <form string="AI Adapter">
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Connection"
                            class="oe_highlight"
                            groups="ai_base.group_manager"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="adapter_type"/>
                            <field name="endpoint"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="api_key" password="True" groups="ai_base.group_manager"/>
                            <field name="api_secret" password="True" groups="ai_base.group_manager"
                                   invisible="adapter_type != 'ernie'"/>
                            <field name="timeout"/>
                            <field name="proxy"/>
                            <field name="sequence"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Models">
                            <field name="model_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="model_kind"/>
                                    <field name="model_name_remote"/>
                                    <field name="is_default"/>
                                    <field name="is_active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ai_adapter_list_view" model="ir.ui.view">
        <field name="name">ai.adapter.list</field>
        <field name="model">ai.adapter</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="adapter_type"/>
                <field name="endpoint"/>
                <field name="model_count"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>
    <record id="ai_adapter_action" model="ir.actions.act_window">
        <field name="name">Adapters</field>
        <field name="res_model">ai.adapter</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
