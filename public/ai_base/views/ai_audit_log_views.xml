<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_audit_log_list_view" model="ir.ui.view">
        <field name="name">ai.audit.log.list</field>
        <field name="model">ai.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="session_id"/>
                <field name="event_type"/>
                <field name="tool_name"/>
                <field name="status"/>
                <field name="latency_ms"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>
    <record id="ai_audit_log_form_view" model="ir.ui.view">
        <field name="name">ai.audit.log.form</field>
        <field name="model">ai.audit.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="user_id"/>
                            <field name="session_id"/>
                            <field name="event_type"/>
                            <field name="tool_name"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="latency_ms"/>
                            <field name="error_code"/>
                            <field name="error_message"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="输入">
                        <field name="input_summary" nolabel="1" colspan="2"/>
                    </group>
                    <group string="输出">
                        <field name="output_summary" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ai_audit_log_action" model="ir.actions.act_window">
        <field name="name">Audit</field>
        <field name="res_model">ai.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
