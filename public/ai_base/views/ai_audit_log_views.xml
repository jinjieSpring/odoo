<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_audit_log_list_view" model="ir.ui.view">
        <field name="name">ai.audit.log.list</field>
        <field name="model">ai.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="event_type"/>
                <field name="tool_name"/>
                <field name="status"
                       widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'error'"
                       decoration-warning="status == 'blocked'"/>
                <field name="block_reason"/>
                <field name="res_name" string="Record"/>
                <field name="source" optional="hide"/>
                <field name="session_id" optional="hide"/>
                <field name="error_code" optional="hide"/>
                <field name="error_message" optional="hide"/>
                <field name="latency_ms" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="ai_audit_log_form_view" model="ir.ui.view">
        <field name="name">ai.audit.log.form</field>
        <field name="model">ai.audit.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="res_id" invisible="1"/>
                        <field name="res_model" invisible="1"/>
                        <button name="action_open_resource" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not res_id">
                            <field name="res_name" widget="statinfo" string="Record"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="event_type"/>
                            <field name="source"/>
                            <field name="user_id"/>
                            <field name="create_date"/>
                            <field name="session_id"/>
                            <field name="message_id" invisible="not message_id"/>
                        </group>
                        <group>
                            <field name="status"
                                   widget="badge"
                                   decoration-success="status == 'success'"
                                   decoration-danger="status == 'error'"
                                   decoration-warning="status == 'blocked'"/>
                            <field name="block_reason" invisible="not block_reason"/>
                            <field name="tool_id" invisible="not tool_id"/>
                            <field name="tool_name"/>
                            <field name="error_code" invisible="not error_code"/>
                            <field name="error_message" invisible="not error_message"/>
                            <field name="latency_ms" invisible="not latency_ms"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Parameters">
                        <field name="input_summary" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Result">
                        <field name="output_summary" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ai_audit_log_action" model="ir.actions.act_window">
        <field name="name">Audit</field>
        <field name="res_model">ai.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
