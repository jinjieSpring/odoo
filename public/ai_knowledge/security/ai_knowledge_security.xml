<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="rule_knowledge_company" model="ir.rule">
            <field name="name">ai.knowledge.base: multi-company</field>
            <field name="model_id" ref="model_ai_knowledge_base"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        </record>

        <record id="rule_document_company" model="ir.rule">
            <field name="name">ai.knowledge.document: multi-company</field>
            <field name="model_id" ref="model_ai_knowledge_document"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        </record>

        <record id="rule_chunk_company" model="ir.rule">
            <field name="name">ai.knowledge.chunk: multi-company</field>
            <field name="model_id" ref="model_ai_knowledge_chunk"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
