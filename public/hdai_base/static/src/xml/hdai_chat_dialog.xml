<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hdai_base.ChatDialog">
        <Dialog size="'xl'" title.translate="AI Assistant"
                contentClass="'o_hdai_chat_dialog'">
            <t t-set-slot="header">
                <h4 class="modal-title text-break flex-grow-1 d-flex align-items-center gap-2">
                    <img class="o_hdai_chat_dialog_icon"
                         src="/hdai_base/static/src/icons/hdai_icon.svg"
                         alt="hdai"/>
                    <span>AI Assistant</span>
                    <button type="button"
                            class="o_hdai_chat_badge o_hdai_header_badge btn btn-sm"
                            t-att-class="'o_hdai_badge_' + state.badge.kind"
                            t-att-title="state.badge.title"
                            t-on-click="openModelConfig">
                        <span class="o_hdai_badge_dot"/>
                        <t t-out="state.badge.text"/>
                    </button>
                </h4>
                <button type="button" class="btn btn-link p-1"
                        title="New Session"
                        t-on-click="newSession">
                    <i class="fa fa-plus"/>
                </button>
                <button type="button" class="btn btn-link p-1"
                        title="Delete Current Session"
                        t-on-click="deleteSession">
                    <i class="fa fa-trash-o"/>
                </button>
                <button type="button" class="btn-close" aria-label="Close"
                        tabindex="-1" t-on-click="props.close"/>
            </t>
            <HdaiChat sessionId="props.sessionId"
                      pendingMessage="props.pendingMessage"
                      onReady="(chat) => this.chatRef = chat"/>
        </Dialog>
    </t>
</templates>
