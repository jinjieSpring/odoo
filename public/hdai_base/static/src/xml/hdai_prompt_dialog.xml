<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hdai_base.PromptDialog">
        <Dialog size="'md'" title.translate="AI Prompt">
            <t t-set-slot="default">
                <div class="o_hdai_prompt_form">
                    <label class="form-label" for="o_hdai_prompt_name">Name</label>
                    <input id="o_hdai_prompt_name" class="form-control"
                           t-model="state.name" placeholder="Prompt title"/>
                    <label class="form-label mt-2" for="o_hdai_prompt_content">Content</label>
                    <textarea id="o_hdai_prompt_content" class="form-control"
                              rows="8" t-model="state.content"
                              placeholder="System prompt content injected into chat requests"/>
                </div>
            </t>
            <t t-set-slot="footer">
                <button class="btn btn-primary"
                        t-att-disabled="!state.name.trim() || !state.content.trim()"
                        t-on-click="save">Save</button>
                <button class="btn btn-secondary" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
