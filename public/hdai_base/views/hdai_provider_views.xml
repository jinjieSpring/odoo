<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hdai_provider_form_view" model="ir.ui.view">
        <field name="name">hdai.provider.form</field>
        <field name="model">hdai.provider</field>
        <field name="arch" type="xml">
            <form string="HD AI Provider">
                <header>
                    <button name="action_test_provider" type="object"
                            string="Test Connection"
                            class="oe_highlight"
                            groups="hdai_base.hdai_group_manager"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="provider_type"/>
                            <field name="api_type"/>
                            <field name="base_url" required="1"/>
                        </group>
                        <group>
                            <field name="api_key" password="True"
                                   groups="hdai_base.hdai_group_manager"/>
                            <field name="priority"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Models">
                            <field name="model_ids"
                                   help="Click a model row to open its configuration page and test the connection.">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="context_length"/>
                                    <field name="max_output_tokens"/>
                                    <field name="temperature" optional="show"/>
                                    <field name="thinking_strength" optional="show"/>
                                    <field name="supports_reasoning" readonly="1"/>
                                    <field name="supports_web_search" readonly="1"/>
                                    <field name="supports_streaming" readonly="1"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hdai_provider_list_view" model="ir.ui.view">
        <field name="name">hdai.provider.list</field>
        <field name="model">hdai.provider</field>
        <field name="arch" type="xml">
            <list string="HD AI Providers" editable="bottom">
                <field name="name" required="1"/>
                <field name="provider_type"/>
                <field name="api_type"/>
                <field name="base_url"/>
                <field name="priority"/>
                <field name="model_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="hdai_provider_action" model="ir.actions.act_window">
        <field name="name">HD AI Providers</field>
        <field name="res_model">hdai.provider</field>
        <field name="view_mode">list,form</field>
        <field name="group_ids" eval="[Command.link(ref('hdai_base.hdai_group_manager'))]"/>
    </record>
</odoo>
