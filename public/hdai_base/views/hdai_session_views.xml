<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hdai_session_list_view" model="ir.ui.view">
        <field name="name">hdai.session.list</field>
        <field name="model">hdai.session</field>
        <field name="arch" type="xml">
            <list string="HD AI Chat Sessions">
                <field name="name"/>
                <field name="user_id"/>
                <field name="model_id"/>
                <field name="provider_id"/>
                <field name="message_count"/>
                <field name="total_tokens"/>
                <field name="state"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <record id="hdai_session_form_view" model="ir.ui.view">
        <field name="name">hdai.session.form</field>
        <field name="model">hdai.session</field>
        <field name="arch" type="xml">
            <form string="HD AI Chat Session">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="model_id"/>
                            <field name="provider_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="message_count"/>
                            <field name="input_tokens"/>
                            <field name="output_tokens"/>
                            <field name="total_tokens"/>
                            <field name="attach_context"/>
                        </group>
                    </group>
                    <field name="context_snapshot" nolabel="1"/>
                    <field name="message_ids" nolabel="1">
                        <list>
                            <field name="role"/>
                            <field name="content"/>
                            <field name="total_tokens"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hdai_session_action" model="ir.actions.act_window">
        <field name="name">HD AI Chat Sessions</field>
        <field name="res_model">hdai.session</field>
        <field name="view_mode">list,form</field>
        <field name="group_ids" eval="[Command.link(ref('hdai_base.hdai_group_manager'))]"/>
    </record>
</odoo>
